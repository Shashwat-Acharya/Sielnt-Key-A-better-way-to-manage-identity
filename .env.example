# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================
# Generate strong passwords (at least 16 characters with mixed case, numbers, symbols)
DB_USER=sk_app_user
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
AUDIT_DB_USER=sk_readonly_user
AUDIT_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
MIGRATION_DB_USER=sk_migration_user
MIGRATION_DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
PG_SUPER_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=CHANGE_ME_TO_50_PLUS_CHARACTER_RANDOM_STRING

# Development: True, Production: False
DEBUG=True

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1,identity.silentkey.me
CANONICAL_HOST=identity.silentkey.me

# =============================================================================
# DATABASE CONNECTION
# =============================================================================
DB_NAME=silentkey_identity
AUDIT_DB_NAME=silentkey_audit
DB_HOST=localhost
DB_PORT=5432
DB_CONNECT_TIMEOUT=10
DB_CONN_MAX_AGE=600

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Set to True only when running migrations
USE_MIGRATION_USER=False

# Optional comma-separated origins for secure browser requests
CSRF_TRUSTED_ORIGINS=https://identity.silentkey.me

# =============================================================================
# SECURITY SETTINGS (Production Only)
# =============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
