# Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# =============================================================================
# DATABASE CREDENTIALS
# =============================================================================
# Generate strong passwords (at least 16 characters with mixed case, numbers, symbols)
sk_app_password=CHANGE_ME_STRONG_PASSWORD_HERE
sk_migration_password=CHANGE_ME_STRONG_PASSWORD_HERE  
sk_readonly_password=CHANGE_ME_STRONG_PASSWORD_HERE
PG_SUPER_PASS=CHANGE_ME_STRONG_PASSWORD_HERE

# =============================================================================
# DJANGO CONFIGURATION
# =============================================================================
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=CHANGE_ME_TO_50_PLUS_CHARACTER_RANDOM_STRING

# Development: True, Production: False
DEBUG=False

# Comma-separated list of allowed hostnames
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE CONNECTION
# =============================================================================
DB_HOST=localhost
DB_PORT=5432

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Set to True only when running migrations
USE_MIGRATION_USER=False

# =============================================================================
# SECURITY SETTINGS (Production Only)
# =============================================================================
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
